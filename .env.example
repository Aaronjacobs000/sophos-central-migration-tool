# Sophos Central Migration Tool - environment configuration
#
# Managed by the welcome wizard and Credentials page in the UI.
# You can also edit manually; restart the server after manual edits.

# ---- Server ----
PORT=3100

# ---- Credential mode: "direct" or "partner" ----
CREDENTIAL_MODE=direct

# ==== Direct mode ====
# Two separate tenant-scoped API credential sets.

# Source tenant (migrating FROM)
SOPHOS_SOURCE_CLIENT_ID=
SOPHOS_SOURCE_CLIENT_SECRET=
SOPHOS_SOURCE_LABEL=

# Destination tenant (migrating TO)
SOPHOS_DEST_CLIENT_ID=
SOPHOS_DEST_CLIENT_SECRET=
SOPHOS_DEST_LABEL=

# ==== Partner mode ====
# One partner/organization credential set; tenants selected from the list.

SOPHOS_PARTNER_CLIENT_ID=
SOPHOS_PARTNER_CLIENT_SECRET=
SOPHOS_PARTNER_LABEL=
SOPHOS_PARTNER_SOURCE_TENANT_ID=
SOPHOS_PARTNER_SOURCE_LABEL=
SOPHOS_PARTNER_DEST_TENANT_ID=
SOPHOS_PARTNER_DEST_LABEL=
